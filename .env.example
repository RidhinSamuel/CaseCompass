# Copy to .env and fill in real values. Never commit .env.
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=casecompass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=case_compass

# --- RabbitMQ ---
RABBITMQ_USER=casecompass
RABBITMQ_PASSWORD=change-me

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# --- CORS: public URL(s) of the frontend, comma-separated ---
CORS_ORIGINS=https://your-domain.com

# --- Hugging Face models ---
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
# "local" runs the model here with fastembed (free); "hf" uses the Hugging Face API (needs HF_TOKEN)
EMBEDDING_BACKEND=local
# "cuda" needs the fastembed-gpu package
EMBEDDING_DEVICE=cpu

# --- Gemini (answer generation) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# --- Deployment ---
# Domain Caddy requests a TLS certificate for (docker-compose.prod.yml)
DOMAIN=your-domain.com
WORKER_REPLICAS=2
